rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, create, update: if owner(uid);
      match /journalEntries/{entryId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.ownerUid == uid;
      }
      match /journalGroups/{groupId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.ownerUid == uid;
      }
    }

    match /sharedJournals/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Existing application collections.
    match /feedback/{id} { allow create: if signedIn(); allow read: if signedIn() && resource.data.uid == request.auth.uid; }
    match /markerSuggestions/{id} { allow create: if signedIn(); }
  }
}

